# ─── Stellar / Horizon ────────────────────────────────────────────────────────
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_EXPLORER=https://stellar.expert/explorer/testnet

# ─── Soroban RPC (smart-contract interactions) ────────────────────────────────

NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

NEXT_PUBLIC_CONTRACT_ID=

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Wallet authentication (SERVER ONLY — never prefix with NEXT_PUBLIC_) ─────
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle. If these
# leak, anyone can mint a token for any wallet and RLS stops meaning anything.

# Supabase Dashboard → Settings → API → JWT Secret.
# Used to sign the access tokens whose `wallet_address` claim RLS authorizes on.
SUPABASE_JWT_SECRET=

# Binds a challenge nonce to the wallet it was issued to.
# Optional — falls back to SUPABASE_JWT_SECRET. Generate with:
#   openssl rand -base64 48
AUTH_CHALLENGE_SECRET=

# Service role key (Supabase Dashboard → Settings → API → service_role).
# Backs the cross-instance replay guard and rate limiter (tables auth_nonces /
# auth_rate_limits, created by supabase-setup.sql). Without it both guards fall
# back to per-process memory, which does not hold on Vercel/Lambda: a captured
# challenge can be replayed against another instance and the rate limit becomes
# 30/min per instance. Required for any multi-instance deployment.
SUPABASE_SERVICE_ROLE_KEY=

# How long a signed-in session lasts before the wallet must sign again.
# Optional — defaults to 43200 (12 hours), capped at 86400 (24 hours).
AUTH_SESSION_TTL_SECONDS=43200

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=SettleX
NEXT_PUBLIC_APP_VERSION=1.0.0

# Canonical public URL — used for OpenGraph/Twitter/PWA absolute URLs.
# In production set this to your real domain (e.g. https://settlex.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── WalletConnect (optional — enables mobile/global wallets) ─────────────────
# Get a free project id at https://dashboard.reown.com (formerly WalletConnect
# Cloud). Required only when you enable the WalletConnect module — see
# docs/WALLET_INTEGRATION.md.
NEXT_PUBLIC_WC_PROJECT_ID=
